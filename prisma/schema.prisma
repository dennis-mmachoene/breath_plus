// Breath+ — Prisma schema. PostgreSQL, normalized, Auth.js v5 compatible.
//   • cuid() ids · createdAt/updatedAt on mutable rows · money in integer cents.
//   • The four Auth.js models (User, Account, Session, VerificationToken) keep
//     their adapter-required field names; our extras carry defaults so the
//     adapter never has to set them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Identity & auth ──────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only users
  role          UserRole  @default(USER)
  isGuest       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?
  invoices          Invoice[]
  breathingSessions BreathingSession[]
  dailyStats        DailyStat[]
  achievements      UserAchievement[]
  conversations     Conversation[]
  folders           ConversationFolder[]
  notifications     Notification[]
  preferences       UserPreferences?
  analyticsEvents   AnalyticsEvent[]
  auditLogs         AuditLog[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum VerificationPurpose {
  EMAIL_VERIFY
  MAGIC_LINK
  PASSWORD_RESET
}

model VerificationToken {
  identifier String
  token      String              @unique
  expires    DateTime
  purpose    VerificationPurpose @default(EMAIL_VERIFY)

  @@unique([identifier, token])
}

// ── Plans, subscriptions & billing ───────────────────────────────────────────

enum PlanId {
  FREE
  PREMIUM
  PREMIUM_PLUS
  CEO_ELITE
}

model Plan {
  id                   PlanId   @id
  name                 String
  tagline              String
  priceCents           Int      @default(0)
  flag                 String?
  breathsPerDay        Int? // null = unlimited
  features             String[]
  stripeProductId      String?
  stripePriceIdMonthly String?
  stripePriceIdAnnual  String?
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum BillingInterval {
  MONTH
  YEAR
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               PlanId
  status               SubscriptionStatus @default(ACTIVE)
  interval             BillingInterval    @default(MONTH)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model Invoice {
  id               String        @id @default(cuid())
  userId           String
  stripeInvoiceId  String?       @unique
  number           String?
  status           InvoiceStatus @default(OPEN)
  amountDueCents   Int
  amountPaidCents  Int           @default(0)
  currency         String        @default("usd")
  description      String?
  hostedInvoiceUrl String?
  pdfUrl           String?
  periodStart      DateTime?
  periodEnd        DateTime?
  issuedAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, issuedAt])
}

// ── The breathing product ────────────────────────────────────────────────────

enum BreathPattern {
  FOUR_SEVEN_EIGHT
  BOX
  COHERENT
  ENERGIZING
}

model BreathingSession {
  id          String        @id @default(cuid())
  userId      String
  pattern     BreathPattern @default(FOUR_SEVEN_EIGHT)
  cycles      Int           @default(1)
  durationSec Int           @default(0)
  completed   Boolean       @default(true)
  startedAt   DateTime      @default(now())
  endedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model DailyStat {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  breaths     Int      @default(0)
  cycles      Int      @default(0)
  durationSec Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Achievement {
  id          String  @id // stable slug
  name        String
  description String
  icon        String
  threshold   Int     @default(1)
  metric      String  @default("lifetime_breaths")
  sortOrder   Int     @default(0)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ── BreathGPT ────────────────────────────────────────────────────────────────

model ConversationFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  title     String   @default("New breath session")
  shareSlug String?  @unique
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, updatedAt])
  @@index([folderId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  model          String?
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ── Notifications, preferences, observability ────────────────────────────────

enum NotificationType {
  LUNG_REMINDER
  FLASH_SALE
  ATMOSPHERE_EXPIRY
  BREATH_STREAK
  ACHIEVEMENT
  SYSTEM
  BILLING
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  actionUrl String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model UserPreferences {
  userId                 String          @id
  theme                  ThemePreference @default(SYSTEM)
  reducedMotion          Boolean         @default(false)
  notifyLungReminders    Boolean         @default(true)
  notifyFlashSales       Boolean         @default(true)
  notifyAtmosphereExpiry Boolean         @default(true)
  notifyBreathStreaks    Boolean         @default(false)
  defaultPattern         BreathPattern   @default(FOUR_SEVEN_EIGHT)
  dailyGoal              Int             @default(3)
  locale                 String          @default("en")

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  props     Json?
  sessionId String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
